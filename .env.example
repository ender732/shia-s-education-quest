# Client (Vite) — ONLY publishable values. Never put SERVICE_ROLE, RESEND, or OPENAI here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
# Alias accepted by server helpers (optional):
# VITE_SUPABASE_ANON_KEY=your-publishable-key

# Server (TanStack Start / Nitro) — same values as above are fine.
# Either naming convention works; server code accepts SUPABASE_* OR VITE_SUPABASE_*.
# If you only set the VITE_ vars (common on Netlify), auth middleware + server fns still work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional admin client for privileged server ops — server-only, never VITE_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email parent link codes via Resend (required to actually send; without it the UI asks to copy the code)
# Set this in Netlify Site settings → Environment variables as well.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="App Name <noreply@example.com>"
# RESEND_FROM="App Name <noreply@example.com>"

# AI book-report grading + PDF lesson drafts + worksheet grading + in-lesson AI coach
# Server-only — set in .env locally AND in Netlify Site settings → Environment variables.
# Restart `npm run dev` after adding.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
# AI_MODEL=gpt-4o-mini
# Optional custom gateway (default https://api.openai.com/v1/chat/completions)
# AI_GATEWAY_URL=
