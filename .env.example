# Client (Vite) — ONLY publishable values. Never put SERVICE_ROLE, RESEND, or OPENAI here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server (TanStack Start / Nitro) — required for AI grading + auth middleware
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional admin client for privileged server ops — server-only, never VITE_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: email parent link codes via Resend (if unset, UI says copy code manually)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Shia's Quest <noreply@yourdomain.com>"

# Optional AI grading (server-only)
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
