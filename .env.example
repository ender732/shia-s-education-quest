# =============================================================================
# Netlify / local env setup
#
# PUBLIC / BUILD (safe in the browser bundle — set in Netlify; Vite embeds VITE_*):
#   VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY (or VITE_SUPABASE_ANON_KEY),
#   VITE_SUPABASE_PROJECT_ID, and optional non-VITE aliases SUPABASE_URL /
#   SUPABASE_PUBLISHABLE_KEY / SUPABASE_PROJECT_ID.
#   These are listed in netlify.toml SECRETS_SCAN_OMIT_KEYS so deploys don't fail.
#
# SERVER-ONLY (Netlify env vars, never VITE_ — must NOT appear in client bundle):
#   GEMINI_API_KEY, GEMINI_MODEL / AI_MODEL, RESEND_API_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, EMAIL_FROM / RESEND_FROM.
#   Set GEMINI_API_KEY in Netlify → Site settings → Environment variables
#   (Scopes: Builds, Functions, and Runtime as needed). Do NOT add it to
#   SECRETS_SCAN_OMIT_KEYS — it must stay server-only and never be inlined.
#   GEMINI_MODEL / AI_MODEL are model names (not secrets); they are listed in
#   SECRETS_SCAN_OMIT_KEYS so Netlify does not fail when the default model
#   string also appears in source. Prefer not marking them as secrets in the UI.
# =============================================================================

# --- Client (Vite) — ONLY publishable values. Never put SERVICE_ROLE, RESEND, or GEMINI here. ---
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anon / publishable key: use either name (code accepts both).
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# --- Server (TanStack Start / Nitro) — publishable aliases (optional duplicates). ---
# Either naming convention works; server code accepts SUPABASE_* OR VITE_SUPABASE_*.
# If you only set the VITE_ vars (common on Netlify), auth middleware + server fns still work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional admin client for privileged server ops — SERVER-ONLY, never VITE_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (server-only) — parent link codes via Resend ---
# Set in Netlify Site settings → Environment variables as well.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="App Name <noreply@example.com>"
# RESEND_FROM="App Name <noreply@example.com>"

# --- AI (server-only) — book-report grading, PDF lesson drafts, worksheets, in-lesson coach ---
# Use GEMINI_API_KEY from Google AI Studio (no VITE_ prefix). Never use VITE_GEMINI_API_KEY.
# Set in .env locally AND in Netlify Site settings → Environment variables
# (Builds / Functions / Runtime). Restart `npm run dev` after adding.
GEMINI_API_KEY=
# Optional alias (also accepted):
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default gemini-3.1-flash-lite — free-tier friendly for new keys).
# Do NOT use gemini-2.5-flash / gemini-2.5-flash-lite / gemini-2.0-* — often blocked for new users.
# GEMINI_MODEL=gemini-3.1-flash-lite
# AI_MODEL=gemini-3.1-flash-lite
# Deprecated: OPENAI_API_KEY / AI_GATEWAY_URL — use GEMINI_API_KEY instead.
